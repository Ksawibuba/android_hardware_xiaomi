type hal_xiaomi_displayfeature_default, domain;
hal_server_domain(hal_xiaomi_displayfeature_default, hal_xiaomi_displayfeature)

type hal_xiaomi_displayfeature_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(hal_xiaomi_displayfeature_default)

binder_call(hal_xiaomi_displayfeature_client, hal_xiaomi_displayfeature_server)
binder_call(hal_xiaomi_displayfeature_default, hal_graphics_composer_default)
binder_call(hal_xiaomi_displayfeature_server, hal_xiaomi_displayfeature_client)

