type hal_xiaomi_touchfeature_default, domain;
hal_server_domain(hal_xiaomi_touchfeature_default, hal_xiaomi_touchfeature)

type hal_xiaomi_touchfeature_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(hal_xiaomi_touchfeature_default)

binder_call(hal_xiaomi_touchfeature_client, hal_xiaomi_touchfeature_server)
binder_call(hal_xiaomi_touchfeature_server, hal_xiaomi_touchfeature_client)

hal_attribute_hwservice(hal_xiaomi_touchfeature, hal_xiaomi_touchfeature_hwservice)

allow hal_xiaomi_touchfeature touchfeature_device:chr_file rw_file_perms;

vndbinder_use(hal_xiaomi_touchfeature)
