type vendor_hal_xiaomi_citsensorservice_default, domain;
hal_server_domain(vendor_hal_xiaomi_citsensorservice_default, vendor_hal_xiaomi_citsensorservice)

type vendor_hal_xiaomi_citsensorservice_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(vendor_hal_xiaomi_citsensorservice_default)

binder_call(vendor_hal_xiaomi_citsensorservice_default, system_server)
binder_use(vendor_hal_xiaomi_citsensorservice_default)

allow vendor_hal_xiaomi_citsensorservice_default fwk_sensor_hwservice:hwservice_manager find;
allow vendor_hal_xiaomi_citsensorservice_default input_device:dir rw_dir_perms;
