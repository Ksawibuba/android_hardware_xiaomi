hal_client_domain(hal_xiaomi_displayfeature_default, vendor_hal_display_color)
hal_client_domain(hal_xiaomi_displayfeature_default, vendor_hal_display_postproc)

allow hal_xiaomi_displayfeature_default vendor_hal_display_config_hwservice:hwservice_manager find;
allow hal_xiaomi_displayfeature_default vendor_qdisplay_service:service_manager find;

get_prop(hal_xiaomi_displayfeature_default, vendor_mpctl_prop)

unix_socket_connect(hal_xiaomi_displayfeature_default, vendor_pps, hal_graphics_composer_default)
